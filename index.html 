<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mehmet & Murat</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #050505;
            overflow: hidden;
            font-family: 'Courier New', Courier, monospace;
        }

        canvas {
            display: block;
        }

        .center-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            z-index: 10;
            color: #ffffff;
            text-shadow: 0 0 20px rgba(255, 105, 180, 0.8);
            pointer-events: none;
        }

        h1 {
            font-size: 2.8rem;
            margin: 0;
            background: linear-gradient(45deg, #ff758c, #ff7eb3, #758cff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        p {
            font-size: 1.2rem;
            color: #a0aec0;
            margin-top: 10px;
            letter-spacing: 2px;
        }
    </style>
</head>
<body>

    <div class="center-text">
        <h1>revan muratıma karışısan seni sikerim</h1>
        <p>∞o telefon birdaha çalışmaz∞</p>
    </div>

    <canvas id="matrixCanvas"></canvas>

    <script>
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        // Akacak karakterler (sayılar, isimler ve tuş simgeleri)
        const characters = "0123456789MEHMETMURAT+-%*/<>[ ]{}#@!";
        const fontSize = 16;
        const columns = canvas.width / fontSize;

        const drops = [];
        for (let i = 0; i < columns; i++) {
            drops[i] = 1;
        }

        function draw() {
            // Arka planı hafif şeffaf siyah yaparak arkada iz kalmasını sağla (Matrix efekti)
            ctx.fillStyle = 'rgba(5, 5, 5, 0.08)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#00ffcc'; // Akış rengi (Neon yeşil/mavi tonu)
            ctx.font = fontSize + 'px monospace';

            for (let i = 0; i < drops.length; i++) {
                // Rastgele bir karakter seç
                const text = characters.charAt(Math.floor(Math.random() * characters.length));
                
                // Aşağıya doğru yazdır
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);

                // Ekranın altına ulaştıysa başa döndür
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                    drops[i] = 0;
                }
                drops[i]++;
            }
        }

        setInterval(draw, 33);

        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });
    </script>
</body>
</html>
