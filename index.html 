import tkinter as tk
import math
import random
W, H = 900, 700
NAME = "I LOVE YOU"
MESSAGE = "You are my everything ❤️"
root = tk.Tk()
root.title("For You ❤️")
root.geometry(f"{W}x{H}")
root.configure(bg="#030003")
canvas = tk.Canvas(
root, width=W, height=H,
bg="#030003", highlightthickness=0
)
canvas.pack()
frame = 0
heart_items = []
particles = []
# Текст
title = canvas.create_text(
W/2, H/2,
text="",
fill="white",
font=("Georgia", 38, "bold")
)
subtitle = canvas.create_text(
W/2, H/2 + 55,
text="",
fill="#ff6688",
font=("Georgia", 17, "italic")
)
# Сердце из надписей
random.seed(12)
for i in range(650):
t = random.uniform(0, 2 * math.pi)
r = math.sqrt(random.random())
x = 16 * math.sin(t)**3 * r
y = (
13 * math.cos(t)
- 5 * math.cos(2*t)
- 2 * math.cos(3*t)
- math.cos(4*t)
) * r
item = canvas.create_text(
W/2, H/2,
text="I love you",
fill="#ff1744",
font=("Arial", random.randint(7, 11), "bold"),
state="hidden"
)
heart_items.append((item, x, y, random.random() * 6.28))
def animate():
global frame
frame += 1
# Сначала плавно появляется текст
if frame < 100:
progress = min(frame / 60, 1)
canvas.itemconfig(title, text=NAME)
canvas.itemconfig(subtitle, text=MESSAGE)
size = int(20 + 18 * progress)
canvas.itemconfig(
title,
font=("Georgia", size, "bold")
)
# Затем текст исчезает
elif frame < 145:
progress = 1 - (frame - 100) / 45
canvas.itemconfig(title, fill="#ffffff")
canvas.itemconfig(subtitle, fill="#ff6688")
if frame == 101:
canvas.itemconfig(subtitle, text="")
# Плавное уменьшение
size = max(1, int(38 * progress))
canvas.itemconfig(
title,
font=("Georgia", size, "bold")
)
# Появляется сердце
else:
canvas.itemconfig(title, state="hidden")
canvas.itemconfig(subtitle, state="hidden")
reveal = min((frame - 145) / 90, 1)
pulse = 1 + 0.035 * math.sin(frame * 0.065)